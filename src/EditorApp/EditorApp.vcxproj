  <!-- Copia i plugin di Qt (piattaforma Windows, stili, formati immagine) accanto all'eseguibile. -->
  <Target Name="EditorVideoDeployQtPlugins" AfterTargets="Build">
    <PropertyGroup>
      <_QtTripletDir>$(VcpkgInstalledDir)$(VcpkgTriplet)\</_QtTripletDir>
      <_QtTripletDir Condition="'$(Configuration)' == 'Debug'">$(VcpkgInstalledDir)$(VcpkgTriplet)\debug\</_QtTripletDir>
    </PropertyGroup>
    <ItemGroup>
      <_QtPlugin Include="$(_QtTripletDir)Qt6\plugins\**\*.dll" />
    </ItemGroup>
    <Warning Condition="'@(_QtPlugin)' == ''" Text="Plugin Qt non trovati in $(_QtTripletDir)Qt6\plugins" />
    <Copy SourceFiles="@(_QtPlugin)" DestinationFiles="@(_QtPlugin->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
